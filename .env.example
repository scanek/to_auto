# AutoTracker Environment Variables Example
# Скопируйте этот файл в .env и укажите ваши настройки

# Режим работы и порты
DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
DATABASE_URL=sqlite+aiosqlite:////app/data/autotracker.db

# JWT Секрет (если не указан, генерируется автоматически)
# SECRET_KEY=your-secure-64-byte-secret-key-here

# Telegram Bot (получите токен у @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# StarLine Telematics (приложение разработчика на developer.starline.ru)
STARLINE_APP_ID=
STARLINE_SECRET=

# Swagger / OpenAPI документация (/docs)
ENABLE_DOCS=false
